<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Kutuphanenin KENDI paket kaynaklari.
    Kutuphane su an hicbir dis pakete bagimli degil ama ilerde
    olursa buradan cekecek. clear ile makine genelindeki
    kaynaklarin sizmasini engelliyoruz; build her makinede ayni.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
