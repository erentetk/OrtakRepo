<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Bu dosya .sln'in yaninda durur ve bu solution altindaki
    butun projeler icin gecerlidir. Git'e commit'le ki projeyi
    acan herkeste ayni paket kaynaklari olsun.
  -->

  <packageSources>
    <!-- clear: makine genelinde tanimli kaynaklarin sizmasini
         engeller, boylece asagida ne yazdiysak o gecerli olur -->
    <clear />

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <!-- Yerel feed. Yol BU DOSYAYA GORE relatif verildi,
         yani klasoru baska yere tasisan da calisir.
         Ilerde GitLab Package Registry'ye gecince burayi
         degistirmen yeterli olacak. -->
    <add key="LocalFeed" value="../LocalFeed" />

    <!--
      GitHub Packages'a gectiginde asagidaki satirin yorumunu kaldir,
      KULLANICI_ADIN kismini degistir. LocalFeed satirini silebilirsin
      ya da ikisi birden dursun; NuGet her iki kaynaga da bakar.

      Kimlik bilgisi BU DOSYAYA YAZILMAZ. Token'i kullanici seviyesindeki
      NuGet.Config dosyasina eklemek icin GITHUB-KURULUM.md dosyasindaki
      3. adimda yazan "dotnet nuget add source" komutunu calistir.
    -->
    <!-- <add key="github" value="https://nuget.pkg.github.com/KULLANICI_ADIN/index.json" /> -->
  </packageSources>

</configuration>
